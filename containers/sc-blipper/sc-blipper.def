Bootstrap: docker
From: condaforge/miniforge3:24.11.3-0@sha256:bcfc04b3562faa8dfd48f3767e2bd7b73a8529f9611b508d42e5bd227db1342d

%labels
    org.opencontainers.image.title sc-blipper
    org.opencontainers.image.description "Unified CPU, CUDA cNMF, and scVI runtime for sc-blipper"
    org.opencontainers.image.source https://github.com/TrynkaLab/sc-blipper

%files
    environment.yml /tmp/sc-blipper-environment.yml
    bin /opt/sc-blipper/bin

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        procps
    rm -rf /var/lib/apt/lists/*

    /opt/conda/bin/conda env create \
        --prefix /opt/sc-blipper-env \
        --file /tmp/sc-blipper-environment.yml
    /opt/conda/bin/conda clean --all --yes
    rm -rf /root/.cache/pip
    rm -f /tmp/sc-blipper-environment.yml

    chmod -R a+rX /opt/sc-blipper/bin /opt/sc-blipper-env

%environment
    export PATH="/opt/sc-blipper-env/bin:/opt/sc-blipper/bin:${PATH}"
    export PYTHONNOUSERSITE=1
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"

%test
    command -v cnmf
    command -v run_preprocess.py
    command -v Rscript
    python -c "import cnmf, jax, scanpy, scvi, torch; print(torch.__version__)"
