// Layer on top of example_cnmf.config; optionally also include GPU options.
// Requires cNMF with sampling support.
// Sampling happens AFTER optional preprocessing/scVI; only sampled cells go
// through prepare, factorize, K-selection, consensus and QC.
// HVGs are recomputed on the sample; inherited full-input HVG lists are not reused.
params.cnmf {
    sampling {
        enabled=true
        sample_method='random' // random or scsampler
        sample_fraction=0.25
        sample_times=1 // Multi-sample consensus is deferred.
        sample_seed=42
        // sample_prefix='pbmc_sample'
    }
}
