// Set this to a shared SIF on the farm. A docker:// GHCR URI also works, but
// pre-pulling one immutable SIF avoids repeated conversion and registry access.
def scBlipperImage = System.getenv('SC_BLIPPER_CONTAINER') ?:
    'file:///lustre/<team>/containers/sc-blipper-poc.sif'

params {
    rn_container = scBlipperImage

    preprocess {
        scvi {
            container = scBlipperImage
        }
    }

    cnmf_gpu {
        container = scBlipperImage

        prepare {
            container = scBlipperImage
        }
    }
}
