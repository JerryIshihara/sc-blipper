// Set SC_BLIPPER_CONTAINER to a shared SIF visible to the driver and every
// compute node. A local image must use an absolute file:/// URI.
// Prebuilt SIFs need no download cache; registry images need a writable,
// shared NXF_APPTAINER_CACHEDIR.
def scBlipperImagePath = System.getenv('SC_BLIPPER_CONTAINER_PATH') ?:
    'file:///absolute/path/to/sc-blipper-amd64.sif'

conda.enabled = false
singularity.enabled = false

apptainer {
    enabled = true
    autoMounts = true
    runOptions = '--cleanenv'
}

params {
    // CnmfConfigurer passes this image to the cNMF processes.
    rn_container = scBlipperImagePath
}
