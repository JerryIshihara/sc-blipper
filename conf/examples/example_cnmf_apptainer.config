// Set SC_BLIPPER_CONTAINER_PATH to a prebuilt SIF visible to the driver and
// every compute node. This example intentionally accepts only an absolute
// file:/// URI, so no image-download cache is required during the run.
def scBlipperImagePath = System.getenv('SC_BLIPPER_CONTAINER_PATH')?.trim()

conda.enabled = false
singularity.enabled = false

apptainer {
    enabled = true
    autoMounts = true
    // --cleanenv removes host cache settings, so give every process writable,
    // node-local cache directories without binding over the container's /tmp.
    runOptions = [
        '--cleanenv',
        '--env NUMBA_CACHE_DIR=/tmp/sc-blipper-cache/numba',
        '--env MPLCONFIGDIR=/tmp/sc-blipper-cache/matplotlib',
        '--env TRITON_CACHE_DIR=/tmp/sc-blipper-cache/triton',
        '--env TORCHINDUCTOR_CACHE_DIR=/tmp/sc-blipper-cache/torchind'
    ].join(' ')
}

params {
    // Process configurers use this as the shared cNMF and scVI image.
    rn_container = scBlipperImagePath
}
