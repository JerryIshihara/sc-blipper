conda.enabled = false
singularity.enabled = false
docker.enabled = false
process {
    executor = 'local'
    cpus = 2
    memory = 2.GB
    time = 10.min
    errorStrategy = 'terminate'
}
executor.queueSize = 2
params {
    rn_container = ''
    rn_conda = null
    rn_scratch = false
    rn_publish_dir = 'results'
    cnmf {
        label = 'normal'
        label_high = 'normal'
        k = '2,3'
        n_iter = 4
        n_workers = 2
        seed = 42
        preprocess = false
        local_density = 2.0
        save_h5ad = true
        sampling {
            enabled = true
            sample_method = 'random'
            sample_fraction = 0.5
            sample_times = 1
            sample_seed = 42
            sample_prefix = null
            sample_embedding_key = 'X_pca'
            sample_export_chunk_size = null
        }
    }
    preprocess.n_variable = 20
}
